## ============== .env.local ============== ##

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public origin used for metadataBase, sitemap, and canonical URLs. No trailing slash.
# Local: http://localhost:3000  Production: https://your-domain
NEXT_PUBLIC_APP_URL=

# Used for direct database connections in edge functions, see Supabase's 'connect' section for key structure
TRANSACTION_POOLER=

## =========== .env.test.local =========== ##

# Copy all prod variables, and these replace the old supabase variables
# 'supabase start' in CLI to find exact values
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
TRANSACTION_POOLER=